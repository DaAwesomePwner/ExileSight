<Application x:Class="ExileSight.App.App"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 ShutdownMode="OnExplicitShutdown">
 <Application.Resources>
  <ResourceDictionary>
   <ResourceDictionary.MergedDictionaries><ResourceDictionary Source="Ui/AppTheme.xaml" /></ResourceDictionary.MergedDictionaries>
   <!-- Shell builders set typography explicitly. Preserve system text colours inside native templates. -->
   <Style TargetType="TextBlock" />
  </ResourceDictionary>
 </Application.Resources>
</Application>
